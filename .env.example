# ---------------------------------------------------------------------------
# Kyros mobile app — example environment
#
# Copy to `.env` (git-ignored) and adjust.
#   cp .env.example .env
#
# IMPORTANT: anything prefixed EXPO_PUBLIC_ is inlined into the JavaScript
# bundle and is readable by anyone with the app. Never put a secret here — no
# API secrets, no payment keys, no database URLs. The bundle is not a safe
# place for anything you would not print on a billboard.
# ---------------------------------------------------------------------------

# Base URL of the kyros-web API.
#   iOS simulator:      http://localhost:3000
#   Android emulator:   http://10.0.2.2:3000
#   Physical device:    http://<your-lan-ip>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Razorpay PUBLISHABLE key id. The secret stays server-side, always.
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Show developer affordances (OTP auto-fill from the dev-mode API response,
# a visible offline-queue inspector). Must be false in any build you ship.
EXPO_PUBLIC_DEV_TOOLS=true
