# ---------------------------------------------------------------------------
# Kyros mobile app — git ignore
# Rule of thumb: if it holds a secret, a signing identity, or a build output,
# it does not belong in git.
# ---------------------------------------------------------------------------

# --- Secrets & environment -------------------------------------------------
.env
.env.*
!.env.example
.envrc

# Expo/EAS credentials. `credentials.json` points at real signing material —
# committing it hands over the ability to ship as you.
credentials.json
google-services.json
GoogleService-Info.plist
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.cer
*.certSigningRequest
.npmrc

# API keys often smuggled in via app config overrides
app.config.local.js
app.config.local.ts
secrets/
.secrets/

# --- Expo -------------------------------------------------------------------
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# --- Native builds ----------------------------------------------------------
# Generated by `expo prebuild`. Regenerate rather than commit, unless the
# project deliberately moves to the bare workflow.
/android/
/ios/
*.orig.*
*.apk
*.aab
*.ipa
*.app
*.dSYM.zip

# --- Node -------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Metro / bundler --------------------------------------------------------
.metro-health-check*
.metro-cache/
*.tsbuildinfo

# --- Testing ----------------------------------------------------------------
coverage/
.nyc_output/
test-results/

# --- Local device data ------------------------------------------------------
# The offline attendance queue and cached rosters contain member personal data.
*.sqlite
*.sqlite3
*.db
/local-data/

# --- Editors & OS -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & scratch ---------------------------------------------------------
logs/
*.log
tmp/
temp/
scratch/
TODO.local.md
